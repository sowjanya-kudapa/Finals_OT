# ======================================================
# DYNAMODB — COUNTRY CODE LOOKUP
# ======================================================
def _get_country2code_sync(cs_country: str) -> str:
    if not cs_country or not cs_country.strip():
        raise ValueError("cs_country is missing or empty.")
    val_upper = cs_country.strip().upper()
    if len(val_upper) != 3:
        raise ValueError("cs_country is not valid.")

    if val_upper in _country_cache:
        logger.info("Country code: '%s' -> '%s' (from cache)", val_upper, _country_cache[val_upper])
        return _country_cache[val_upper]

    try:
        resp = country_table.get_item(Key={"country3code": val_upper})
        item = resp.get("Item")
        if item:
            country2code = item["country2code"].upper()
            _country_cache[val_upper] = country2code
            logger.info("Country code: '%s' -> '%s' (from DynamoDB, now cached)", val_upper, country2code)
            return country2code
    except ClientError as e:
        raise RuntimeError(f"DynamoDB error [{e.response['Error']['Code']}]: {e}") from e
    raise ValueError(
        f"Country '{cs_country}' not found in ot_country_map. "
        "Please provide a valid 3-letter country code."
    )

async def get_country2code(cs_country: str) -> str:
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, _get_country2code_sync, cs_country)


# ======================================================
# PRE-FLIGHT VALIDATION
# ======================================================
def preflight_validate(cs_consents: list, cs_subscriptions: list, cid: str) -> tuple:
    valid_consents      = []
    valid_subscriptions = []
    skipped_items       = []

    for idx, consent in enumerate(cs_consents):
        identifier    = consent.get("identifier")
        consent_val   = consent.get("consent")
        signature_raw = consent.get("signatureDate", "")
        create_raw    = consent.get("createDate", "")
        pos           = f"cs_consents[{idx}]"

        if not identifier or not isinstance(identifier, str) or not identifier.strip():
            logger.warning("[%s] CONSENT_SKIP_NO_IDENTIFIER | %s", cid, pos)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "reason": "Identifier is empty or missing"})
            continue

        if not _validate_identifier_format(identifier):
            logger.warning("[%s] CONSENT_SKIP_INVALID_IDENTIFIER_FORMAT | %s | identifier='%s'", cid, pos, identifier)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "reason": "Invalid identifier format"})
            continue

        if not isinstance(consent_val, bool):
            logger.warning("[%s] CONSENT_SKIP_INVALID_CONSENT_VALUE | %s | identifier='%s' | value='%s'", cid, pos, identifier, consent_val)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "reason": f"Invalid consent value '{consent_val}' — only true or false are valid"})
            continue

        if not signature_raw:
            logger.warning("[%s] CONSENT_SKIP_NO_SIGNATURE_DATE | %s | identifier='%s'", cid, pos, identifier)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "reason": "signatureDate is missing or empty"})
            continue

        normalized_sig_date, sig_date_error = _validate_strict_date(signature_raw)
        if not normalized_sig_date:
            reason = f"signatureDate '{signature_raw}' — {sig_date_error}"
            logger.warning("[%s] CONSENT_SKIP_INVALID_SIGNATURE_DATE | %s | identifier='%s' | reason='%s'", cid, pos, identifier, reason)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "signatureDate": signature_raw, "reason": reason})
            continue

        parsed_sig = datetime.strptime(normalized_sig_date, "%Y-%m-%dT%H:%M:%S")
        if parsed_sig > datetime.utcnow():
            reason = f"signatureDate '{normalized_sig_date}' is greater than today's date and is not accepted"
            logger.warning("[%s] CONSENT_SKIP_FUTURE_SIGNATURE_DATE | %s | identifier='%s' | reason='%s'", cid, pos, identifier, reason)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "signatureDate": signature_raw, "reason": reason})
            continue

        if not create_raw:
            normalized_create_date = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S")
            logger.info("[%s] CONSENT_CREATE_DATE_NULL | %s | identifier='%s' | createDate is null, using system date='%s'", cid, pos, identifier, normalized_create_date)
        else:
            normalized_create_date, create_date_error = _validate_strict_date(create_raw)
            if not normalized_create_date:
                reason = f"createDate '{create_raw}' — {create_date_error}"
                logger.warning("[%s] CONSENT_SKIP_INVALID_CREATE_DATE | %s | identifier='%s' | reason='%s'", cid, pos, identifier, reason)
                skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "createDate": create_raw, "reason": reason})
                continue

            parsed_create = datetime.strptime(normalized_create_date, "%Y-%m-%dT%H:%M:%S")
            if parsed_create > datetime.utcnow():
                reason = f"createDate '{normalized_create_date}' is greater than today's date and is not accepted"
                logger.warning("[%s] CONSENT_SKIP_FUTURE_CREATE_DATE | %s | identifier='%s' | reason='%s'", cid, pos, identifier, reason)
                skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "createDate": create_raw, "reason": reason})
                continue

        source = consent.get("source")
        if not source or not isinstance(source, str) or not source.strip():
            logger.error("[%s] CONSENT_SKIP_NO_SOURCE | %s | identifier='%s'", cid, pos, identifier)
            skipped_items.append({"type": "consent", "position": pos, "identifier": identifier, "reason": "source is missing or empty"})
            continue

        consent = dict(consent)
        consent["signatureDate"]          = normalized_sig_date
        consent["_normalized_createDate"] = normalized_create_date
        valid_consents.append(consent)

    for idx, sub in enumerate(cs_subscriptions):
        identifier  = sub.get("identifier")
        opt_in      = sub.get("optIn")
        opt_in_date = sub.get("optInDate", "")
        pos         = f"cs_subscriptions[{idx}]"

        if not identifier or not isinstance(identifier, str) or not identifier.strip():
            logger.warning("[%s] SUBSCRIPTION_SKIP_NO_IDENTIFIER | %s", cid, pos)
            skipped_items.append({"type": "subscription", "position": pos, "identifier": identifier, "reason": "identifier is missing or empty"})
            continue

        if not isinstance(opt_in, bool):
            logger.warning("[%s] SUBSCRIPTION_SKIP_INVALID_OPT_IN_VALUE | %s | identifier='%s' | value='%s'", cid, pos, identifier, opt_in)
            skipped_items.append({"type": "subscription", "position": pos, "identifier": identifier, "reason": f"optIn must be true or false, got '{opt_in}'"})
            continue

        if not opt_in_date:
            logger.warning("[%s] SUBSCRIPTION_SKIP_NO_OPT_IN_DATE | %s | identifier='%s'", cid, pos, identifier)
            skipped_items.append({"type": "subscription", "position": pos, "identifier": identifier, "reason": "optInDate is missing or empty"})
            continue

        normalized_date, date_error = _validate_strict_date(opt_in_date)
        if not normalized_date:
            reason = f"optInDate '{opt_in_date}' — {date_error}"
            logger.warning("[%s] SUBSCRIPTION_SKIP_INVALID_OPT_IN_DATE | %s | identifier='%s' | reason='%s'", cid, pos, identifier, reason)
            skipped_items.append({"type": "subscription", "position": pos, "identifier": identifier, "reason": reason})
            continue

        opt_location = sub.get("optLocation")
        if not opt_location or not isinstance(opt_location, str) or not opt_location.strip():
            logger.error("[%s] SUBSCRIPTION_SKIP_NO_OPT_LOCATION | %s | identifier='%s'", cid, pos, identifier)
            skipped_items.append({"type": "subscription", "position": pos, "identifier": identifier, "reason": "optLocation is missing or empty"})
            continue

        sub = dict(sub)
        sub["_normalized_optInDate"] = normalized_date
        valid_subscriptions.append(sub)

    logger.info("[%s] Preflight done | consents=%d | subscriptions=%d | skipped=%d",
                cid, len(valid_consents), len(valid_subscriptions), len(skipped_items))
    return valid_consents, valid_subscriptions, skipped_items


# ======================================================
# CONSENT PURPOSE VALIDATION
# ======================================================
async def _validate_consent_purposes(
    valid_consents: list,
    skipped_items: list,
    cid: str,
) -> tuple:
    checked_consents = []
    for consent in valid_consents:
        identifier = consent.get("identifier", "")
        try:
            purpose_id = await get_purpose_id(identifier)
            consent = dict(consent)
            consent["_cached_purpose_id"] = purpose_id
            checked_consents.append(consent)
            logger.info("[%s] Consent '%s' purpose validated | found in purpose table", cid, identifier)
        except RuntimeError:
            logger.error("[%s] Consent '%s' skipped | not found in purpose table", cid, identifier)
            skipped_items.append({
                "type":       "consent",
                "identifier": identifier,
                "reason":     f"identifier '{identifier}' not found in purpose table — not a valid consent for this country",
            })
    return checked_consents, skipped_items


