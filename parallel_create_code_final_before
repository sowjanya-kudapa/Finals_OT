# ======================================================
# BUILD CONSENT PAYLOAD  (normal path)
# ======================================================
async def build_consent_payload(
    event: dict,
    request_info: str,
    skipped_items: list,
    country_code: str,
    cid: str,
) -> tuple:
    email        = event.get("email", "")
    first_name   = event.get("given_name") or ""
    last_name    = event.get("family_name") or ""
    cs_country   = event.get("cs_country", "")
    hcp_status   = event.get("hcp_status") or "ACTIVE"
    profile_type = event.get("profile_type") or "HCP"

    if country_code == "US":
        mobile_number = event.get("mobile_number") or None
        if mobile_number:
            logger.info("[%s] USA market | mobile_number present | will be added as additional identifier", cid)
        else:
            logger.info("[%s] USA market | mobile_number not provided | will be skipped", cid)
    else:
        mobile_number = None
        logger.info("[%s] Non-USA market (country='%s') | mobile_number ignored", cid, country_code)

    ot_uuid = f"OT_{uuid.uuid4()}"
    logger.info("[%s] Generated OT UUID: %s", cid, ot_uuid)
    logger.info("[%s] hcp_status=%s | profile_type=%s", cid, hcp_status, profile_type)

    cs_consents      = event.get("_valid_consents", [])
    cs_subscriptions = event.get("_valid_subscriptions", [])

    # ── Deduplicate consents ──────────────────────────────────────────────────
    identifier_counts = Counter(c.get("identifier", "") for c in cs_consents)

    for identifier, count in identifier_counts.items():
        if count > 1:
            logger.error(
                "[%s] DUPLICATE_CONSENT_IDENTIFIER | Consent '%s' — identifier appears more than once "
                "in cs_consents. All occurrences will be skipped.",
                cid, identifier,
            )

    unique_consents = []
    for consent in cs_consents:
        identifier = consent.get("identifier", "")
        if identifier_counts[identifier] > 1:
            skipped_items.append({
                "type":       "consent",
                "identifier": identifier,
                "position":   "duplicate",
                "reason": (
                    f"Duplicate identifier '{identifier}' — appears more than once "
                    f"in cs_consents. All occurrences are skipped."
                ),
            })
        else:
            unique_consents.append(consent)

    dupes_dropped = len(cs_consents) - len(unique_consents)
    logger.info(
        "[%s] Dedup complete | original=%d | after_dedup=%d | duplicates_skipped=%d",
        cid, len(cs_consents), len(unique_consents), dupes_dropped,
    )
    cs_consents = unique_consents
    # ─────────────────────────────────────────────────────────────────────────

    logger.info("[%s] Building payload | consents=%d | subscriptions=%d",
                cid, len(cs_consents), len(cs_subscriptions))

    date_map: dict = defaultdict(lambda: {"consents": [], "subscriptions": []})
    for c in cs_consents:
        date_map[c.get("signatureDate", "")]["consents"].append(c)
    for s in cs_subscriptions:
        date_map[s["_normalized_optInDate"]]["subscriptions"].append(s)

    all_dates = list(dict.fromkeys(
        [c.get("signatureDate", "") for c in cs_consents]
        + ([cs_subscriptions[0]["_normalized_optInDate"]] if cs_subscriptions else [])
    ))

    logger.info("[%s] Date buckets (%d): %s", cid, len(all_dates), all_dates)

    def _build(interaction_date, purposes):
        return _base_payload(ot_uuid, email, first_name, last_name, cs_country,
                             hcp_status, profile_type, request_info, interaction_date, purposes,
                             mobile_number=mobile_number)

    payloads = []
    for date in all_dates:
        bucket = date_map[date]
        consent_purposes, sub_purposes = await asyncio.gather(
            _map_consents_to_purposes(bucket["consents"], skipped_items, cid),
            _map_subscriptions_to_purposes(bucket["subscriptions"], country_code, skipped_items, cid),
        )
        all_purposes = consent_purposes + sub_purposes
        if not all_purposes:
            logger.warning("[%s] Date bucket '%s' has no valid purposes, skipping", cid, date)
            continue
        logger.info("[%s] Date bucket '%s' | total purposes=%d -> 1 call", cid, date, len(all_purposes))
        payloads.append(_build(date, all_purposes))

    logger.info("[%s] Total CONSENT_URL calls planned: %d", cid, len(payloads))
    return "single", payloads, ot_uuid


# ======================================================
# PARALLEL CONSENT SUBMISSION
# ======================================================
async def _submit_all_payloads(
    http_session: aiohttp.ClientSession,
    access_token: str,
    payloads: list,
    cid: str,
    call_counts: dict,
) -> dict:
    total = len(payloads)
    logger.info("[%s] Submitting %d receipt(s) concurrently with asyncio.gather", cid, total)

    async def _submit_one(idx, single_payload):
        interaction_date = single_payload.get("interactionDate", "unknown")
        logger.info("[%s] Submitting receipt %d/%d | interactionDate='%s'",
                    cid, idx, total, interaction_date)
        logger.info("[%s] Receipt %d/%d payload: %s",
                    cid, idx, total, json.dumps(single_payload, indent=4))
        await submit_consent(http_session, access_token, single_payload, cid, call_counts)
        logger.info("[%s] Receipt %d/%d submitted successfully | interactionDate='%s'",
                    cid, idx, total, interaction_date)
        return interaction_date

    results = await asyncio.gather(
        *[_submit_one(idx, p) for idx, p in enumerate(payloads, start=1)],
        return_exceptions=True,
    )

    succeeded = []
    failed    = []

    for idx, result in enumerate(results, start=1):
        interaction_date = payloads[idx - 1].get("interactionDate", "unknown")
        if isinstance(result, Exception):
            logger.error("[%s] Receipt %d/%d FAILED | interactionDate='%s' | error='%s'",
                         cid, idx, total, interaction_date, str(result))
            failed.append({"receipt_number": idx, "interaction_date": interaction_date, "error": str(result)})
        else:
            logger.info("[%s] Receipt %d/%d CONFIRMED succeeded | interactionDate='%s'",
                        cid, idx, total, interaction_date)
            succeeded.append({"receipt_number": idx, "interaction_date": interaction_date})

    logger.info("[%s] Submission summary | total=%d | succeeded=%d | failed=%d",
                cid, total, len(succeeded), len(failed))
    if failed:
        logger.error("[%s] FAILED RECEIPTS DETAIL: %s", cid, json.dumps(failed, indent=2))
    if succeeded:
        logger.info("[%s] SUCCEEDED RECEIPTS DETAIL: %s", cid, json.dumps(succeeded, indent=2))

    return {
        "succeeded":       succeeded,
        "failed":          failed,
        "submitted_count": len(succeeded),
        "total":           total,
        "all_failed":      total > 0 and len(failed) == total,
        "partial":         len(failed) > 0 and len(succeeded) > 0,
    }


# ======================================================
# ASYNC CORE HANDLER
# ======================================================
async def _async_handler(event: dict, context) -> dict:

    cid = str(uuid.uuid4())[:12]
    call_counts: dict = defaultdict(int)
    skipped_items: list = []

    logger.info("[%s] Lambda invocation started | remaining_ms=%d",
                cid, context.get_remaining_time_in_millis())

    if REQUESTS_CA_BUNDLE:
        if os.path.exists(REQUESTS_CA_BUNDLE):
            logger.info("[%s] SSL FILE CHECK: File EXISTS at '%s' | SSL = ON ✅", cid, REQUESTS_CA_BUNDLE)
        else:
            logger.error("[%s] SSL FILE CHECK: File MISSING at '%s' | SSL = OFF ❌", cid, REQUESTS_CA_BUNDLE)
    else:
        logger.info("[%s] SSL FILE CHECK: REQUESTS_CA_BUNDLE not set | SSL = OFF ❌", cid)

    try:
        original_event = json.loads(json.dumps(event))
    except (TypeError, ValueError) as e:
        logger.warning("[%s] Deep copy failed, using shallow copy | %s", cid, str(e))
        original_event = event.copy()

    is_partial        = False
    data_subject      = {}
    submission_result = {}

    # ── 1. Validate src ───────────────────────────────
    query_params = event.get("queryStringParameters") or {}
    src = query_params.get("src", "")
    if not src:
        logger.error("[%s] src param is missing", cid)
        return _build_response(400, {"message": "Query String Parameter is empty"})
    if src.lower() != "ciam":
        logger.error("[%s] Invalid src param | received='%s'", cid, src)
        return _build_response(400, {"message": "Invalid Query String Parameter"})
    logger.info("[%s] src=ciam validated", cid)

    # ── 2. Parse body ─────────────────────────────────
    try:
        logger.info("[%s] Parsing request body | type=%s", cid, type(event.get("body")))
        payload = parse_event_body(event)
    except Exception as e:
        logger.error("[%s] Failed to parse body | %s", cid, str(e))
        return _build_response(400, {"message": f"Invalid request body: {str(e)}"})

    # ── 3. Validate email ─────────────────────────────
    email = payload.get("email")
    if not email:
        logger.error("[%s] email is missing in request", cid)
        return _build_response(400, {"message": "email is missing in the request."})
    if not validate_email(email):
        logger.error("[%s] Invalid email format | email='%s'", cid, email)
        return _build_response(400, {"message": "email format is invalid. Please provide a valid email address."})
    logger.info("[%s] Email validated | email='%s'", cid, email)

    # ── 4. Validate cs_country ────────────────────────
    cs_country = payload.get("cs_country", "")
    try:
        country_code = await get_country2code(cs_country)
        logger.info("[%s] Country validated and resolved | '%s' -> '%s'", cid, cs_country, country_code)
    except ValueError as e:
        logger.error("[%s] Country validation failed | %s", cid, str(e))
        return _build_response(400, {"message": str(e)})
    except RuntimeError as e:
        logger.error("[%s] Country DynamoDB error | stage=COUNTRY_LOOKUP | %s", cid, str(e))
        _log_api_summary(call_counts, cid)
        await send_to_dlq(original_event, str(e), "COUNTRY_LOOKUP")
        return _build_response(500, {"message": "Could not validate country. Please try again later."})

    # ── 4b. List type validation ──────────────────────
    raw_consents      = payload.get("cs_consents")
    raw_subscriptions = payload.get("cs_subscriptions")

    if raw_consents is None:
        raw_consents = []
    if raw_subscriptions is None:
        raw_subscriptions = []

    if not isinstance(raw_consents, list):
        return _build_response(400, {"message": "cs_consents must be a list."})
    if not isinstance(raw_subscriptions, list):
        return _build_response(400, {"message": "cs_subscriptions must be a list."})
    if raw_consents and not isinstance(raw_consents[0], dict):
        return _build_response(400, {"message": "cs_consents must be a list of objects, not a list of strings."})
    if raw_subscriptions and not isinstance(raw_subscriptions[0], dict):
        return _build_response(400, {"message": "cs_subscriptions must be a list of objects, not a list of strings."})

    # ── 5. Retrieve secrets ───────────────────────────
    try:
        secret        = await get_secret()
        client_id     = secret["client_id"]
        client_secret = secret["client_secret"]
    except Exception as e:
        logger.error("[%s] Failed to load secrets | stage=SECRETS_MANAGER | %s", cid, str(e))
        _log_api_summary(call_counts, cid)
        await send_to_dlq(original_event, str(e), "SECRETS_MANAGER")
        return _build_response(500, {"message": "Could not load configuration. Please try again later."})

    connector = aiohttp.TCPConnector(limit=20)
    async with aiohttp.ClientSession(connector=connector) as http_session:

        # ── 6. Fetch access token ─────────────────────
        try:
            access_token = await fetch_token(http_session, client_id, client_secret, cid, call_counts)
        except Exception as e:
            logger.error("[%s] Failed to fetch token | stage=FETCH_TOKEN | %s", cid, str(e))
            _log_api_summary(call_counts, cid)
            await send_to_dlq(original_event, str(e), "FETCH_TOKEN")
            return _build_response(502, {"message": "Could not connect to OneTrust to get an access token. Please try again later."})

        # ── 7. Check if profile exists ────────────────
        try:
            profile_exists = await check_profile(http_session, access_token, email, cid, call_counts)
        except Exception as e:
            logger.error("[%s] Profile check failed | stage=PROFILE_CHECK | %s", cid, str(e))
            _log_api_summary(call_counts, cid)
            await send_to_dlq(original_event, str(e), "PROFILE_CHECK")
            return _build_response(502, {"message": "Could not connect to OneTrust. Please try again later."})

        if profile_exists:
            logger.info("[%s] Profile already exists, no action needed", cid)
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            return _build_response(409, {"message": "Profile already exists in OneTrust."})

        # ── 8. Fetch collection point token ───────────
        try:
            request_info = await fetch_request_info(http_session, access_token, cid, call_counts)
        except Exception as e:
            logger.error("[%s] Collection point fetch failed | stage=COLLECTION_POINT | %s", cid, str(e))
            _log_api_summary(call_counts, cid)
            await send_to_dlq(original_event, str(e), "COLLECTION_POINT")
            return _build_response(502, {"message": "Could not connect to OneTrust. Please try again later."})

        # ── 9. Validate consents & subscriptions ──────
        valid_consents      = []
        valid_subscriptions = []

        if raw_consents or raw_subscriptions:
            valid_consents, valid_subscriptions, skipped_items = preflight_validate(
                raw_consents, raw_subscriptions, cid
            )

            if valid_subscriptions:
                valid_subscriptions, skipped_items = await _validate_subscription_preferences(
                    valid_subscriptions, country_code, skipped_items, cid
                )

            if valid_subscriptions:
                valid_subscriptions, skipped_items = await _resolve_subscription_dates(
                    valid_subscriptions, country_code, skipped_items, cid
                )

            if valid_consents:
                valid_consents, skipped_items = await _validate_consent_purposes(
                    valid_consents, skipped_items, cid
                )

            if not valid_consents and not valid_subscriptions:
                logger.warning(
                    "[%s] All consents/subscriptions were skipped after validation | "
                    "will still submit default purpose receipt",
                    cid,
                )
                _log_skipped_summary(skipped_items, cid)

        else:
            logger.warning(
                "[%s] No cs_consents or cs_subscriptions received | "
                "will submit default purpose receipt only",
                cid,
            )

        # ── 10. Build normal payloads ─────────────────
        payloads_list = []
        ot_uuid       = None

        if valid_consents or valid_subscriptions:
            payload["_valid_consents"]      = valid_consents
            payload["_valid_subscriptions"] = valid_subscriptions

            try:
                route, payloads_list, ot_uuid = await build_consent_payload(
                    payload, request_info, skipped_items, country_code, cid
                )
                logger.info("[%s] Payload built | route='%s' | total_receipts=%d",
                            cid, route, len(payloads_list))
            except ValueError as e:
                logger.error("[%s] Payload build validation error | %s", cid, str(e))
                _log_api_summary(call_counts, cid)
                _log_skipped_summary(skipped_items, cid)
                return _build_response(400, {"message": str(e)})
            except Exception as e:
                logger.error("[%s] Payload build failed | stage=BUILD_PAYLOAD | %s", cid, str(e))
                _log_api_summary(call_counts, cid)
                _log_skipped_summary(skipped_items, cid)
                await send_to_dlq(original_event, str(e), "BUILD_PAYLOAD")
                return _build_response(500, {"message": "Could not build the consent payload. Please check the request data and try again."})

        # ── 11. Generate OT UUID if not yet set ───────
        # (only happens when no valid consents/subs — build_consent_payload
        #  generates it internally when the normal path runs)
        if not ot_uuid:
            ot_uuid = f"OT_{uuid.uuid4()}"
            logger.info("[%s] Generated OT UUID (default purpose only path): %s", cid, ot_uuid)

        # ── 12. Always append default purpose receipt ─
        try:
            default_payload = await _build_default_purpose_payload(
                payload, request_info, country_code, cs_country, ot_uuid, cid
            )
            payloads_list.append(default_payload)
            logger.info(
                "[%s] Default purpose receipt appended | ot_uuid='%s' | total_receipts=%d",
                cid, ot_uuid, len(payloads_list),
            )
        except RuntimeError as e:
            logger.error(
                "[%s] Failed to build default purpose payload | stage=BUILD_DEFAULT_PAYLOAD | %s",
                cid, str(e),
            )
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            await send_to_dlq(original_event, str(e), "BUILD_DEFAULT_PAYLOAD")
            return _build_response(500, {
                "message": "Could not build the default consent payload. Please try again later."
            })

        # ── 13. Submit all receipts together ──────────
        try:
            submission_result = await _submit_all_payloads(
                http_session, access_token, payloads_list, cid, call_counts
            )
        except Exception as e:
            logger.error("[%s] Unexpected submission error | stage=CONSENT_SUBMISSION_UNEXPECTED | %s", cid, str(e))
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            await send_to_dlq(original_event, str(e), "CONSENT_SUBMISSION_UNEXPECTED")
            return _build_response(502, {"message": "Could not submit consent to OneTrust. Please try again later."})

        if submission_result["all_failed"]:
            failure_reason = (
                f"All {submission_result['total']} consent receipt(s) failed to submit. "
                f"Failed interaction dates: {[f['interaction_date'] for f in submission_result['failed']]}"
            )
            logger.error("[%s] All consent submissions failed | stage=CONSENT_SUBMISSION | %s",
                         cid, failure_reason)
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            await send_to_dlq(original_event, failure_reason, "CONSENT_SUBMISSION")
            return _build_response(502, {"message": "Could not submit consent to OneTrust. Please try again later."})

        if submission_result["submitted_count"] == 0:
            logger.error("[%s] No receipts submitted", cid)
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            return _build_response(400, {"message": _build_skipped_message(skipped_items)})

        is_partial = submission_result["partial"]
        if is_partial:
            failed_dates   = [f["interaction_date"] for f in submission_result["failed"]]
            failure_reason = (
                f"Partial submission: {len(submission_result['failed'])}/"
                f"{submission_result['total']} receipt(s) failed. "
                f"Failed interaction dates: {failed_dates}"
            )
            logger.warning("[%s] [PARTIAL_SUBMISSION] %s | succeeded_dates=%s",
                           cid, failure_reason,
                           [s["interaction_date"] for s in submission_result["succeeded"]])
            try:
                partial_dlq_event = json.loads(json.dumps(original_event))
            except (TypeError, ValueError):
                partial_dlq_event = original_event.copy()
            partial_dlq_event["_failed_interaction_dates"] = failed_dates
            await send_to_dlq(partial_dlq_event, failure_reason, "CONSENT_SUBMISSION_PARTIAL")
            logger.info("[%s] [PARTIAL_SUBMISSION] DLQ message queued | failed_dates=%s",
                        cid, failed_dates)

        # ── 14. Fetch created profile ─────────────────
        try:
            remaining_ms      = context.get_remaining_time_in_millis()
            remaining_seconds = remaining_ms / 1000
            max_retry_budget  = min(6.9, remaining_seconds * 0.6)
            retry_delays_all  = [0.3, 0.6, 1.0, 2.0, 3.0]

            retry_delays = []
            cumulative = 0.0
            for d in retry_delays_all:
                if cumulative + d > max_retry_budget:
                    break
                retry_delays.append(d)
                cumulative += d

            if not retry_delays:
                retry_delays = [min(0.3, max_retry_budget)]

            logger.info(
                "[%s] Profile fetch retry plan | attempts=%d | delays=%s | budget=%.1fs | remaining=%.1fs",
                cid, len(retry_delays), retry_delays, max_retry_budget, remaining_seconds
            )

            data_subject = {}

            for attempt, delay in enumerate(retry_delays, start=1):
                logger.info(
                    "[%s] Waiting %.1fs before fetching created profile | attempt=%d/%d",
                    cid, delay, attempt, len(retry_delays)
                )
                await asyncio.sleep(delay)

                try:
                    fetched = await fetch_data_subject_by_uuid(
                        http_session, access_token, ot_uuid, cid, call_counts
                    )
                except Exception as fetch_err:
                    logger.warning(
                        "[%s] Profile fetch attempt %d/%d raised error | %s",
                        cid, attempt, len(retry_delays), str(fetch_err)
                    )
                    continue

                if fetched:
                    data_subject = fetched
                    logger.info(
                        "[%s] Profile fetched successfully on attempt %d/%d | uuid='%s'",
                        cid, attempt, len(retry_delays), ot_uuid
                    )
                    break

                logger.warning(
                    "[%s] Profile not ready yet | attempt=%d/%d | uuid='%s' | will retry",
                    cid, attempt, len(retry_delays), ot_uuid
                )
            else:
                logger.error(
                    "[%s] Profile not found after %d attempts | uuid='%s' | "
                    "consent was recorded, profile may appear in OneTrust shortly",
                    cid, len(retry_delays), ot_uuid
                )
                data_subject = {
                    "warning": (
                        "Profile was created and consent recorded, but the profile could not "
                        "be retrieved after multiple attempts. It may appear in OneTrust shortly."
                    )
                }
                await send_to_dlq(
                    original_event,
                    f"Profile not found after {len(retry_delays)} fetch attempts for UUID={ot_uuid}",
                    "FETCH_CREATED_PROFILE_RETRY_EXHAUSTED"
                )

            logger.info("[%s] Created profile result: %s", cid, json.dumps(data_subject))

        except Exception as e:
            logger.error("[%s] Unexpected error during profile fetch | stage=FETCH_CREATED_PROFILE | %s",
                         cid, str(e))
            _log_api_summary(call_counts, cid)
            _log_skipped_summary(skipped_items, cid)
            await send_to_dlq(original_event, str(e), "FETCH_CREATED_PROFILE")
            return _build_response(502, {
                "message": "Consent was recorded but could not fetch the profile from OneTrust. Please try again later.",
            })

    # ── Final summaries ───────────────────────────────
    _log_api_summary(call_counts, cid)
    _log_skipped_summary(skipped_items, cid)

    logger.info("[%s] Handler completed successfully | remaining_ms=%d",
                cid, context.get_remaining_time_in_millis())

    # ── Final response ────────────────────────────────
    if is_partial:
        failed_dates = [f["interaction_date"] for f in submission_result["failed"]]
        logger.warning("[%s] Returning 207 Partial Content | succeeded=%d | failed=%d | failed_dates=%s",
                       cid, submission_result["submitted_count"],
                       len(submission_result["failed"]), failed_dates)
        return _build_response(207, {
            "message": (
                f"Profile created with partial consent. "
                f"{submission_result['submitted_count']}/{submission_result['total']} "
                f"receipt(s) submitted successfully. "
                f"{len(submission_result['failed'])} receipt(s) failed and have been queued for automatic retry."
            ),
            "profile": data_subject,
        })

    return _build_response(200, {
        "message": "Profile created and consent recorded successfully in OneTrust.",
        "profile": data_subject,
    })


# ======================================================
# LAMBDA ENTRY POINT
# ======================================================
def lambda_handler(event, context):
    remaining_ms      = context.get_remaining_time_in_millis()
    remaining_seconds = remaining_ms / 1000 - 2
    safe_timeout = max(remaining_seconds, 1.0)

    logger.info(
        "Lambda handler starting | remaining_ms=%d | wait_for_timeout=%.1fs",
        remaining_ms, safe_timeout
    )

    try:
        return asyncio.run(
            asyncio.wait_for(
                _async_handler(event, context),
                timeout=safe_timeout
            )
        )
    except asyncio.TimeoutError:
        logger.error(
            "Lambda handler timed out | remaining_ms=%d",
            context.get_remaining_time_in_millis()
        )
        return {
            "isBase64Encoded": False,
            "statusCode": 504,
            "headers": {"Content-Type": "application/json"},
            "body": json.dumps({"message": "Request timed out. Please try again later."}),
        }
