# ======================================================
def _get_secret_sync() -> dict:
    try:
        resp = secrets_client.get_secret_value(SecretId=SECRET_NAME)
    except ClientError as e:
        raise RuntimeError(f"Secrets Manager error [{e.response['Error']['Code']}]: {e}") from e
    secret = resp.get("SecretString")
    if not secret:
        raise ValueError("SecretString is empty or missing.")
    return json.loads(secret)

async def get_secret() -> dict:
    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, _get_secret_sync)


# ======================================================
# ONETRUST TOKEN
# ======================================================
async def fetch_token(
    session: aiohttp.ClientSession,
    client_id: str,
    client_secret: str,
    cid: str,
    call_counts: dict,
) -> str:
    _log_api_call(call_counts, "TOKEN_URL", cid)
    logger.info("[%s] Fetching access token", cid)
    async with session.post(
        TOKEN_URL,
        data={
            "grant_type":    "client_credentials",
            "client_id":     client_id,
            "client_secret": client_secret,
        },
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        ssl=SSL_CONTEXT if SSL_CONTEXT else False,
        timeout=aiohttp.ClientTimeout(total=REQUEST_TIMEOUT),
    ) as resp:
        logger.info("[%s] Token response | status=%d", cid, resp.status)
        if not resp.ok:
            text = await resp.text()
            raise RuntimeError(f"Token API HTTP {resp.status}: {text}")
        data = await resp.json()
    token = data.get("access_token")
    if not token:
        raise ValueError("No access_token in response.")
    logger.info("[%s] Access token fetched successfully", cid)
    return token


# ======================================================
# CHECK DATA SUBJECT PROFILE
# ======================================================
async def check_profile(
    session: aiohttp.ClientSession,
    access_token: str,
    email: str,
    cid: str,
    call_counts: dict,
) -> bool:
    _log_api_call(call_counts, "PROFILES_URL_check", cid)
    logger.info("[%s] Checking profile for email='%s'", cid, email)
    async with session.get(
        PROFILES_URL,
        headers={
            "Authorization":    f"Bearer {access_token}",
            "dataElementName":  "email_address",
            "dataElementValue": email,
        },
        ssl=SSL_CONTEXT if SSL_CONTEXT else False,
        timeout=aiohttp.ClientTimeout(total=REQUEST_TIMEOUT),
    ) as resp:
        logger.info("[%s] Profile check response | status=%d", cid, resp.status)
        if resp.status == 404:
            logger.info("[%s] Profile not found (404) for email='%s'", cid, email)
            return False
        if not resp.ok:
            text = await resp.text()
            raise RuntimeError(f"Profile check HTTP {resp.status}: {text}")
        data = await resp.json()
    total = data.get("totalElements", 0)
    if total > 0:
        logger.info("[%s] Profile already exists for email='%s'", cid, email)
        return True
    logger.info("[%s] Profile does not exist for email='%s'", cid, email)
    return False


