# ======================================================
# SUBSCRIPTION DATE RESOLUTION
# ======================================================
async def _resolve_subscription_dates(
    valid_subscriptions: list,
    country_code: str,
    skipped_items: list,
    cid: str,
) -> tuple:

    global_first_date = None

    for sub in valid_subscriptions:
        identifier = sub.get("identifier", "").strip()
        norm_date  = sub.get("_normalized_optInDate", "")
        unique_id  = f"{country_code}_{identifier}"

        if not norm_date:
            continue

        if sub.get("_cached_pref_item"):
            global_first_date = norm_date
            logger.info(
                "[%s] First valid optInDate found | identifier='%s' | country_key='%s' | "
                "date='%s' | will use for all subscriptions",
                cid, identifier, unique_id, norm_date,
            )
            break
        else:
            logger.warning(
                "[%s] Skipping for date selection | identifier='%s' | "
                "reason: not found in preference table for country='%s'",
                cid, identifier, country_code,
            )

    if not global_first_date:
        logger.warning("[%s] SUBSCRIPTION_SKIP_NO_VALID_DATE | reason: no valid subscription found with valid optInDate.", cid)
        return [], skipped_items

    logger.info("[%s] interactionDate='%s' will be applied to all %d subscription(s)",
                cid, global_first_date, len(valid_subscriptions))

    for sub in valid_subscriptions:
        identifier    = sub.get("identifier", "").strip()
        original_date = sub.get("_normalized_optInDate", "")
        if original_date != global_first_date:
            logger.info("[%s] Subscription '%s' | own date='%s' -> overridden to '%s'",
                        cid, identifier, original_date, global_first_date)
        sub["_normalized_optInDate"] = global_first_date

    logger.info("[%s] All %d subscription(s) assigned interactionDate='%s'",
                cid, len(valid_subscriptions), global_first_date)
    return valid_subscriptions, skipped_items


# ======================================================
# BUILD BASE PAYLOAD SKELETON
# ======================================================
def _base_payload(ot_uuid, email, first_name, last_name, cs_country,
                  hcp_status, profile_type, request_info, interaction_date, purposes,
                  mobile_number=None):
    additional_identifiers = {"email_address": email}
    if mobile_number:
        additional_identifiers["mobile_number"] = mobile_number

    return {
        "identifier":            ot_uuid,
        "identifierType":        "Sanofi_OT_uuid",
        "additionalIdentifiers": additional_identifiers,
        "requestInformation":    request_info,
        "interactionDate":       interaction_date,
        "purposes":              purposes,
        "dsDataElements": {
            "first_name":      first_name,
            "last_name":       last_name,
            "hcp_countrycode": cs_country,
            "hcp_status":      hcp_status,
            "profile_type":    profile_type,
        },
    }


# ======================================================
# MAP consents -> purposes list
# ======================================================
async def _map_consents_to_purposes(consents: list, skipped_items: list, cid: str) -> list:
    purposes = []
    for consent in consents:
        identifier  = consent.get("identifier")
        consent_val = consent.get("consent")

        if not consent.get("signatureDate"):
            logger.warning("[%s] Consent '%s' has no signatureDate, skipping", cid, identifier)
            continue

        transaction_type = "CONFIRMED" if consent_val else "OPT_OUT"
        logger.info("[%s] Consent '%s' | value=%s | type=%s", cid, identifier, consent_val, transaction_type)

        purpose_id = consent.get("_cached_purpose_id")
        if not purpose_id:
            try:
                purpose_id = await get_purpose_id(identifier)
            except RuntimeError as e:
                logger.error("[%s] Consent '%s' skipped | %s", cid, identifier, str(e))
                skipped_items.append({
                    "type":       "consent",
                    "identifier": identifier,
                    "reason":     f"identifier '{identifier}' not found in purpose table — not a valid consent for this country",
                })
                continue

        note_text = json.dumps({
            "source":      consent.get("source", ""),
            "createdDate": consent.get("_normalized_createDate", ""),
        }, separators=(",", ":"))

        logger.info("[%s] Consent '%s' mapped to PurposeID='%s' | noteText=%s",
                    cid, identifier, purpose_id, note_text)
        purposes.append({
            "Id":              purpose_id,
            "TransactionType": transaction_type,
            "PurposeNote": {
                "noteType":     "UNSUBSCRIBE_REASON",
                "noteLanguage": "en-us",
                "noteText":     note_text,
            },
        })
    return purposes


# ======================================================
# MAP subscriptions -> purposes list
# ======================================================
async def _map_subscriptions_to_purposes(
    cs_subscriptions: list,
    country_code: str,
    skipped_items: list,
    cid: str,
) -> list:
    if not cs_subscriptions:
        return []

    purpose_choices = defaultdict(lambda: {"purpose_id": None, "pref_list_id": None, "choices": []})

    for sub in cs_subscriptions:
        identifier = sub.get("identifier", "")
        opt_in     = sub.get("optIn", False)
        unique_id  = f"{country_code}_{identifier}"
        logger.info("[%s] Looking up subscription '%s'", cid, unique_id)

        pref_item = sub.get("_cached_pref_item")
        if not pref_item:
            try:
                pref_item = await get_preference_item(unique_id)
            except RuntimeError as e:
                logger.error("[%s] Subscription '%s' skipped | %s", cid, unique_id, str(e))
                skipped_items.append({
                    "type":       "subscription",
                    "identifier": identifier,
                    "reason":     f"identifier '{identifier}' not found in preference table for country — not a valid subscription for this country",
                })
                continue

        purpose_id   = pref_item.get("PurposeID")
        pref_list_id = pref_item.get("PurposeListID")
        option_id    = pref_item.get("CustomePrefernceOptionid")
        if not purpose_id or not pref_list_id or not option_id:
            logger.error("[%s] Subscription '%s' skipped | missing fields in preference table", cid, unique_id)
            skipped_items.append({
                "type":       "subscription",
                "identifier": identifier,
                "reason":     f"identifier '{identifier}' found in preference table but missing required fields (PurposeID / PurposeListID / OptionID)",
            })
            continue

        purpose_choices[purpose_id]["purpose_id"]   = purpose_id
        purpose_choices[purpose_id]["pref_list_id"] = pref_list_id
        purpose_choices[purpose_id]["choices"].append({
            "TransactionType": "OPT_IN" if opt_in else "OPT_OUT",
            "OptionId":        option_id,
        })
        logger.info("[%s] Subscription '%s' mapped to PurposeID='%s' | optIn=%s",
                    cid, unique_id, purpose_id, opt_in)

    purposes = []
    for purpose_id, data in purpose_choices.items():
        purposes.append({
            "Id":              purpose_id,
            "TransactionType": "CHANGE_PREFERENCES",
            "CustomPreferences": [{"Id": data["pref_list_id"], "Choices": data["choices"]}],
        })
        logger.info("[%s] Built CHANGE_PREFERENCES | PurposeID='%s' | choices=%d",
                    cid, purpose_id, len(data["choices"]))
    return purposes


